{
  "name": "dtt-rs",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "bindings": "pnpm --filter dtt-desktop bindings",
    "desktop:build": "pnpm --filter dtt-desktop build",
    "desktop:dev": "pnpm --filter dtt-desktop tauri dev",
    "desktop:tauri": "pnpm --filter dtt-desktop tauri",
    "tauri": "pnpm --filter dtt-desktop tauri",
    "i18n:check": "pnpm --filter dtt-desktop i18n:check",
    "i18n:generate": "pnpm --filter dtt-desktop i18n:generate",
    "desktop:test": "pnpm --filter dtt-desktop test"
  }
}
